class_name Sfx
extends Node
## Round audio: pooled one-shot effects (2D and positional 3D), crossfading
## looping ambience, the pod klaxon and the spectating-ghost mix.
## Add as a child of the round's World. Sounds live in res://assets/audio/ and are
## generated by tools/generate_audio.py (music: tools/generate_music.py).
## Unknown sound names are a silent no-op.
## Music is global (one player under the SceneTree root, shared by every Sfx and
## surviving scene changes): call the static Sfx.set_music(state) from anywhere.
## Works with only the Master bus and under the dummy (headless) audio driver.

const AUDIO_DIR := "res://assets/audio/"
const SOUNDS: PackedStringArray = [
	"ambience_station", "ambience_emergency", "alarm_pod", "power_up", "power_down",
	"pickup", "drop", "insert_cell", "shuttle_launch_start", "countdown_tick", "abort",
	"shove", "footstep_1", "footstep_2", "footstep_3", "ui_click", "win_crew", "win_infiltrator",
	"gunshot", "downed", "revive", "throw", "airlock_warning", "airlock_vent", "ghost_drift",
]
const POOL_SIZE := 12
const SFX_BUS := "SFX"
const AMBIENCE_BUS := "Ambience"
const AMBIENCE_FADE := 1.5
const ALARM_DB := -3.0
const ALARM_FADE := 0.2
const BLACKOUT_DB := -8.0
## Extra attenuation for blackout when no bus low-pass is available.
const BLACKOUT_DB_NO_FILTER := -12.0
const BLACKOUT_CUTOFF := 700.0
## Ghost mode: everything but the ghost pad is muffled (SFX bus low-pass) and a bit quieter.
const GHOST_SFX_CUTOFF := 900.0
const GHOST_SFX_DB := -3.0
const GHOST_SFX_DB_NO_FILTER := -9.0
const OPEN_CUTOFF := 20000.0
const FILTER_SPEED := 3.0
const MUSIC_DIR := "res://assets/audio/music/"
const MUSIC_BUS := "Music"
## Default Music bus level, low so music never fights voice or proximity chat.
## Applied only when Sfx creates the bus (a settings menu may change it afterwards).
const MUSIC_BUS_DB := -8.0
const MUSIC_FADE := 2.0
## set_music() state -> track in MUSIC_DIR (looping).
const MUSIC := {"lobby": "lobby_theme", "tension": "round_tension", "extraction": "extraction_drive"}
const UNIT_SIZE := 6.0
const MAX_DISTANCE := 30.0
## Random pitch spread (+/- fraction) per sound-name prefix, so repeats don't sound cloned.
const PITCH_JITTER := {"footstep": 0.05, "drop": 0.04, "pickup": 0.03, "shove": 0.04,
	"gunshot": 0.03, "throw": 0.05}

var _streams := {}
var _loop_streams := {}
var _pool_2d: Array[AudioStreamPlayer] = []
var _pool_3d: Array[AudioStreamPlayer3D] = []
var _next_2d := 0
var _next_3d := 0
var _amb: Array[AudioStreamPlayer] = []
var _amb_sound: Array[String] = ["", ""]
var _amb_level: Array[float] = [0.0, 0.0]   # fade position 0..1 (equal-power curve)
var _amb_target: Array[float] = [0.0, 0.0]
var _amb_active := -1
var _amb_state := ""
var _ghost := false
var _alarm: AudioStreamPlayer
var _alarm_wanted := false
var _sfx_bus := "Master"
var _amb_bus := "Master"
## bus name -> {"fx": AudioEffectLowPassFilter, "cutoff": float, "target": float}
var _filters := {}
var _built := false
var _rng := RandomNumberGenerator.new()
static var _music: MusicHost


func _ready() -> void:
	_build()
	_apply_ambience()  # anything requested before we entered the tree
	if _alarm_wanted:
		start_alarm()


func _exit_tree() -> void:
	# Stopping before the players are freed lets the AudioServer release its playbacks.
	_stop_players()


## Silence everything immediately (one-shots, ambience, alarm, music). Ghost mode is kept.
func stop_all() -> void:
	stop_music_now()
	_alarm_wanted = false
	_amb_state = ""
	_amb_target.fill(0.0)
	_amb_level.fill(0.0)
	_amb_sound.fill("")
	_amb_active = -1
	_stop_players()


func _stop_players() -> void:
	for player in _pool_2d:
		player.stop()
	for player in _pool_3d:
		player.stop()
	for player in _amb:
		player.stop()
	if _alarm != null:
		_alarm.stop()


## Play a one-shot. `at` = Vector3 (or a Node3D) for positional audio, else 2D.
## "footstep" picks one of the three footstep variants at random.
## An unknown or missing sound does nothing and prints nothing.
func play(sound: String, at = null, volume_db := 0.0) -> void:
	_build()
	if not is_inside_tree() or sound.is_empty():
		return
	var key := sound
	if key == "footstep":
		key = "footstep_%d" % _rng.randi_range(1, 3)
	var stream := get_stream(key)
	if stream == null:
		return
	var pitch := 1.0
	for prefix in PITCH_JITTER:
		if key.begins_with(prefix):
			var spread: float = PITCH_JITTER[prefix]
			pitch = 1.0 + _rng.randf_range(-spread, spread)
			break
	var gain_db := volume_db + _sfx_offset_db()
	var pos = at
	if pos is Node3D:
		pos = (pos as Node3D).global_position if (pos as Node3D).is_inside_tree() else (pos as Node3D).position
	if pos is Vector3:
		var i3 := _take(_pool_3d, _next_3d)
		_next_3d = (i3 + 1) % _pool_3d.size()
		var p3 := _pool_3d[i3]
		p3.stop()
		p3.stream = stream
		p3.volume_db = gain_db
		p3.pitch_scale = pitch
		p3.global_position = pos
		p3.play()
	else:
		var i2 := _take(_pool_2d, _next_2d)
		_next_2d = (i2 + 1) % _pool_2d.size()
		var p2 := _pool_2d[i2]
		p2.stop()
		p2.stream = stream
		p2.volume_db = gain_db
		p2.pitch_scale = pitch
		p2.play()


## "restored" (station hum), "emergency" (failing power), "blackout" (emergency,
## quieter and muffled) or "off". Crossfades over AMBIENCE_FADE seconds.
## While ghost mode is on the state is remembered and applied when it ends.
func set_ambience(state: String) -> void:
	_build()
	var key := state.strip_edges().to_lower()
	match key:
		"restored", "station", "normal", "emergency", "blackout":
			pass
		"", "off", "none", "silent":
			key = "off"
		_:
			push_warning("Sfx.set_ambience: unknown state '%s'" % state)
			return
	_amb_state = key
	_apply_ambience()


## Spectating ghost: crossfade the ambience to the airy ghost_drift loop and
## muffle every other sound (low-pass on the SFX bus, or just quieter without one).
func set_ghost_mode(on: bool) -> void:
	_build()
	if on == _ghost:
		return
	_ghost = on
	_set_filter_target(_sfx_bus, GHOST_SFX_CUTOFF if on else OPEN_CUTOFF)
	if _alarm != null and _alarm.playing and _alarm_wanted:
		_alarm.volume_db = ALARM_DB + _sfx_offset_db()
	_apply_ambience()


## "lobby", "tension", "extraction" or "off": crossfades the global music over
## MUSIC_FADE seconds on the "Music" bus. Static, so main.gd can call it without
## an Sfx instance: Sfx.set_music("lobby"). Unknown states are ignored.
static func set_music(state: String) -> void:
	var key := state.strip_edges().to_lower()
	if key in ["", "none", "silent", "stop"]:
		key = "off"
	if key != "off" and not MUSIC.has(key):
		push_warning("Sfx.set_music: unknown state '%s'" % state)
		return
	var host := _music_host()
	if host != null:
		host.request(key)


static func get_music_state() -> String:
	return _music.state if is_instance_valid(_music) else "off"


static func is_music_playing() -> bool:
	return is_instance_valid(_music) and _music.is_playing()


## Cut the music at once (no fade).
static func stop_music_now() -> void:
	if is_instance_valid(_music):
		_music.stop_now()


static func _music_host() -> MusicHost:
	if is_instance_valid(_music):
		return _music
	var tree := Engine.get_main_loop() as SceneTree
	if tree == null or tree.root == null:
		return null
	_music = MusicHost.new(_ensure_bus(MUSIC_BUS, MUSIC_BUS_DB))
	tree.root.add_child.call_deferred(_music)
	return _music


func is_ghost_mode() -> bool:
	return _ghost


func start_alarm() -> void:
	_build()
	_alarm_wanted = true
	if not is_inside_tree():
		return
	var stream := get_loop_stream("alarm_pod")
	if stream == null:
		return
	_alarm.volume_db = ALARM_DB + _sfx_offset_db()
	if not _alarm.playing:
		_alarm.stream = stream
		_alarm.play()


func stop_alarm() -> void:
	_alarm_wanted = false  # _process fades it out and stops it


func is_alarm_playing() -> bool:
	return _alarm != null and _alarm.playing


func get_ambience_state() -> String:
	return "" if _amb_state == "off" else _amb_state


## Cached stream for res://assets/audio/<sound>.wav, or null (silently) if there is none.
func get_stream(sound: String) -> AudioStream:
	if _streams.has(sound):
		return _streams[sound]
	var stream: AudioStream = null
	if sound.is_valid_filename():
		var path := AUDIO_DIR + sound + ".wav"
		if ResourceLoader.exists(path):
			stream = load(path) as AudioStream
	_streams[sound] = stream
	return stream


## Looping copy of a stream (the shared one-shot resource is left untouched).
func get_loop_stream(sound: String) -> AudioStream:
	if _loop_streams.has(sound):
		return _loop_streams[sound]
	var base := get_stream(sound)
	var looped: AudioStream = null
	if base is AudioStreamWAV:
		var wav := (base as AudioStreamWAV).duplicate() as AudioStreamWAV
		wav.loop_mode = AudioStreamWAV.LOOP_FORWARD
		wav.loop_begin = 0
		wav.loop_end = frame_count(wav)
		looped = wav
	elif base != null:
		looped = base.duplicate()
		if "loop" in looped:
			looped.set("loop", true)
	_loop_streams[sound] = looped
	return looped


## Number of sample frames in a WAV stream.
@warning_ignore("integer_division")
static func frame_count(wav: AudioStreamWAV) -> int:
	var channels := 2 if wav.stereo else 1
	match wav.format:
		AudioStreamWAV.FORMAT_16_BITS:
			return wav.data.size() / (2 * channels)
		AudioStreamWAV.FORMAT_8_BITS:
			return wav.data.size() / channels
	return int(round(wav.get_length() * wav.mix_rate))


func preload_all() -> int:
	var loaded := 0
	for sound in SOUNDS:
		if get_stream(sound) != null:
			loaded += 1
	return loaded


func _process(delta: float) -> void:
	if not _built:
		return
	var step := delta / AMBIENCE_FADE
	for i in 2:
		var player := _amb[i]
		if _amb_level[i] != _amb_target[i]:
			_amb_level[i] = move_toward(_amb_level[i], _amb_target[i], step)
		var gain := sin(_amb_level[i] * PI * 0.5)
		player.volume_db = linear_to_db(maxf(gain, 0.0001))
		if _amb_level[i] <= 0.0 and _amb_target[i] <= 0.0 and player.playing:
			player.stop()
			_amb_sound[i] = ""
	if not _alarm_wanted and _alarm.playing:
		_alarm.volume_db -= delta * 60.0 / ALARM_FADE
		if _alarm.volume_db <= -60.0:
			_alarm.stop()
	var k := clampf(delta * FILTER_SPEED, 0.0, 1.0)
	for bus_name in _filters:
		var f: Dictionary = _filters[bus_name]
		var cutoff: float = f.cutoff
		var target: float = f.target
		if is_equal_approx(cutoff, target):
			continue
		cutoff = exp(lerpf(log(cutoff), log(target), k))
		if absf(cutoff - target) < 1.0:
			cutoff = target
		f.cutoff = cutoff
		(f.fx as AudioEffectLowPassFilter).cutoff_hz = cutoff
		_set_filter_enabled(bus_name, cutoff < OPEN_CUTOFF * 0.95)


## Drive the two ambience slots toward whatever ghost mode / _amb_state ask for.
func _apply_ambience() -> void:
	var sound := ""
	var level := 1.0
	var cutoff := OPEN_CUTOFF
	if _ghost:
		sound = "ghost_drift"
	else:
		match _amb_state:
			"restored", "station", "normal":
				sound = "ambience_station"
			"emergency":
				sound = "ambience_emergency"
			"blackout":
				sound = "ambience_emergency"
				var has_filter := _filters.has(_amb_bus)
				level = _level_for_db(BLACKOUT_DB if has_filter else BLACKOUT_DB_NO_FILTER)
				cutoff = BLACKOUT_CUTOFF
	_set_filter_target(_amb_bus, cutoff)
	if not is_inside_tree():
		return  # applied again from _ready()
	if sound == "":
		_amb_target.fill(0.0)
		return
	# Same loop already up (or fading out): just retarget its level.
	for i in 2:
		if _amb_sound[i] == sound and _amb[i].playing:
			_amb_target[i] = level
			_amb_target[1 - i] = 0.0
			_amb_active = i
			return
	var stream := get_loop_stream(sound)
	if stream == null:
		return
	var next := 1 if _amb_active == 0 else 0
	if _amb_active != -1:
		_amb_target[_amb_active] = 0.0
	var player := _amb[next]
	player.stop()
	player.stream = stream
	player.volume_db = -80.0
	_amb_sound[next] = sound
	_amb_level[next] = 0.0
	_amb_target[next] = level
	_amb_active = next
	# Random start point so every round doesn't open on the same creak.
	player.play(_rng.randf() * maxf(stream.get_length() - 0.1, 0.0))


func _sfx_offset_db() -> float:
	if not _ghost:
		return 0.0
	return GHOST_SFX_DB if _filters.has(_sfx_bus) else GHOST_SFX_DB_NO_FILTER


func _build() -> void:
	if _built:
		return
	_built = true
	_rng.randomize()
	_sfx_bus = _ensure_bus(SFX_BUS)
	_amb_bus = _ensure_bus(AMBIENCE_BUS)
	_setup_filter(_sfx_bus)
	_setup_filter(_amb_bus)
	for i in POOL_SIZE:
		var p2 := AudioStreamPlayer.new()
		p2.name = "Sfx2D%d" % i
		p2.bus = _sfx_bus
		add_child(p2)
		_pool_2d.append(p2)
		var p3 := AudioStreamPlayer3D.new()
		p3.name = "Sfx3D%d" % i
		p3.bus = _sfx_bus
		p3.unit_size = UNIT_SIZE
		p3.max_distance = MAX_DISTANCE
		p3.attenuation_model = AudioStreamPlayer3D.ATTENUATION_INVERSE_SQUARE_DISTANCE
		p3.doppler_tracking = AudioStreamPlayer3D.DOPPLER_TRACKING_DISABLED
		add_child(p3)
		_pool_3d.append(p3)
	for i in 2:
		var a := AudioStreamPlayer.new()
		a.name = "Ambience%d" % i
		a.bus = _amb_bus
		a.volume_db = -80.0
		add_child(a)
		_amb.append(a)
	_alarm = AudioStreamPlayer.new()
	_alarm.name = "Alarm"
	_alarm.bus = _sfx_bus
	add_child(_alarm)


## Prefer an idle player starting at the round-robin cursor; otherwise steal the cursor's.
func _take(pool: Array, cursor: int) -> int:
	var count := pool.size()
	for offset in count:
		var idx := (cursor + offset) % count
		if not pool[idx].playing:
			return idx
	return cursor % count


static func _ensure_bus(bus_name: String, initial_db := 0.0) -> String:
	var idx := AudioServer.get_bus_index(bus_name)
	if idx == -1:
		AudioServer.add_bus()
		idx = AudioServer.bus_count - 1
		if idx <= 0:
			return "Master"
		AudioServer.set_bus_name(idx, bus_name)
		AudioServer.set_bus_send(idx, "Master")
		AudioServer.set_bus_volume_db(idx, initial_db)
		idx = AudioServer.get_bus_index(bus_name)
	return bus_name if idx > 0 else "Master"


## Find or add a (disabled) low-pass on our own bus. Master is never touched;
## without a filter, blackout and ghost mode fall back to lower volumes.
func _setup_filter(bus_name: String) -> void:
	if bus_name == "Master" or _filters.has(bus_name):
		return
	var bus := AudioServer.get_bus_index(bus_name)
	if bus <= 0:
		return
	var fx: AudioEffectLowPassFilter = null
	for i in AudioServer.get_bus_effect_count(bus):
		var effect := AudioServer.get_bus_effect(bus, i)
		if effect is AudioEffectLowPassFilter:
			fx = effect
			break
	if fx == null:
		fx = AudioEffectLowPassFilter.new()
		AudioServer.add_bus_effect(bus, fx)
	fx.cutoff_hz = OPEN_CUTOFF
	_filters[bus_name] = {"fx": fx, "cutoff": OPEN_CUTOFF, "target": OPEN_CUTOFF}
	_set_filter_enabled(bus_name, false)


func _set_filter_target(bus_name: String, cutoff: float) -> void:
	if _filters.has(bus_name):
		_filters[bus_name].target = cutoff


func _set_filter_enabled(bus_name: String, enabled: bool) -> void:
	var bus := AudioServer.get_bus_index(bus_name)
	if bus <= 0 or not _filters.has(bus_name):
		return
	var fx: AudioEffect = _filters[bus_name].fx
	for i in AudioServer.get_bus_effect_count(bus):
		if AudioServer.get_bus_effect(bus, i) == fx:
			if AudioServer.is_bus_effect_enabled(bus, i) != enabled:
				AudioServer.set_bus_effect_enabled(bus, i, enabled)
			return


## Fade position (0..1) whose equal-power gain equals the given dB.
static func _level_for_db(gain_db: float) -> float:
	return asin(clampf(db_to_linear(gain_db), 0.0, 1.0)) / (PI * 0.5)


## Global music player: two AudioStreamPlayers crossfading looped tracks.
class MusicHost extends Node:
	var state := "off"
	var _bus := "Master"
	var _players: Array[AudioStreamPlayer] = []
	var _track: Array[String] = ["", ""]
	var _level: Array[float] = [0.0, 0.0]
	var _target: Array[float] = [0.0, 0.0]
	var _active := -1
	var _streams := {}

	func _init(bus_name: String) -> void:
		name = "SfxMusic"
		_bus = bus_name
		process_mode = Node.PROCESS_MODE_ALWAYS  # keep fading while the game is paused
		for i in 2:
			var p := AudioStreamPlayer.new()
			p.name = "Music%d" % i
			p.bus = _bus
			p.volume_db = -80.0
			add_child(p)
			_players.append(p)

	func _ready() -> void:
		_apply()  # a request made before we were in the tree

	func _exit_tree() -> void:
		for p in _players:
			p.stop()

	func request(new_state: String) -> void:
		state = new_state
		if is_inside_tree():
			_apply()

	func is_playing() -> bool:
		for p in _players:
			if p.playing:
				return true
		return false

	func stop_now() -> void:
		state = "off"
		for i in 2:
			_players[i].stop()
			_track[i] = ""
			_level[i] = 0.0
			_target[i] = 0.0
		_active = -1

	func _apply() -> void:
		var track: String = Sfx.MUSIC.get(state, "")
		if track == "":
			_target.fill(0.0)
			return
		for i in 2:
			if _track[i] == track and _players[i].playing:
				_target[i] = 1.0
				_target[1 - i] = 0.0
				_active = i
				return
		var stream := _loop(track)
		if stream == null:
			return
		var next := 1 if _active == 0 else 0
		if _active != -1:
			_target[_active] = 0.0
		var p := _players[next]
		p.stop()
		p.stream = stream
		p.volume_db = -80.0
		_track[next] = track
		_level[next] = 0.0
		_target[next] = 1.0
		_active = next
		p.play()

	func _loop(track: String) -> AudioStream:
		if _streams.has(track):
			return _streams[track]
		var path := Sfx.MUSIC_DIR + track + ".wav"
		var looped: AudioStream = null
		if ResourceLoader.exists(path):
			var base := load(path) as AudioStream
			if base is AudioStreamWAV:
				var wav := (base as AudioStreamWAV).duplicate() as AudioStreamWAV
				wav.loop_mode = AudioStreamWAV.LOOP_FORWARD
				wav.loop_begin = 0
				wav.loop_end = Sfx.frame_count(wav)
				looped = wav
			elif base != null:
				looped = base.duplicate()
				if "loop" in looped:
					looped.set("loop", true)
		_streams[track] = looped
		return looped

	func _process(delta: float) -> void:
		var step := delta / Sfx.MUSIC_FADE
		for i in 2:
			if _level[i] != _target[i]:
				_level[i] = move_toward(_level[i], _target[i], step)
			_players[i].volume_db = linear_to_db(maxf(sin(_level[i] * PI * 0.5), 0.0001))
			if _level[i] <= 0.0 and _target[i] <= 0.0 and _players[i].playing:
				_players[i].stop()
				_track[i] = ""
