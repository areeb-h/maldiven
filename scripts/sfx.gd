class_name Sfx
extends Node
## Round audio: pooled one-shot effects (2D and positional 3D), crossfading
## looping ambience and the pod klaxon. Add as a child of the round's World.
## Sounds live in res://assets/audio/ and are generated by tools/generate_audio.py.
## Works with only the Master bus and under the dummy (headless) audio driver.

const AUDIO_DIR := "res://assets/audio/"
const SOUNDS: PackedStringArray = [
	"ambience_station", "ambience_emergency", "alarm_pod", "power_up", "power_down",
	"pickup", "drop", "insert_cell", "shuttle_launch_start", "countdown_tick", "abort",
	"shove", "footstep_1", "footstep_2", "footstep_3", "ui_click", "win_crew", "win_infiltrator",
]
const POOL_SIZE := 12
const SFX_BUS := "SFX"
const AMBIENCE_BUS := "Ambience"
const AMBIENCE_FADE := 1.5
const ALARM_DB := -3.0
const ALARM_FADE := 0.2
const BLACKOUT_DB := -8.0
## Extra attenuation for blackout when no bus low-pass is available.
const BLACKOUT_DB_NO_FILTER := -12.0
const BLACKOUT_CUTOFF := 700.0
const OPEN_CUTOFF := 20000.0
const UNIT_SIZE := 6.0
const MAX_DISTANCE := 30.0
## Random pitch spread (+/- fraction) per sound-name prefix, so repeats don't sound cloned.
const PITCH_JITTER := {"footstep": 0.05, "drop": 0.04, "pickup": 0.03, "shove": 0.04}

var _streams := {}
var _loop_streams := {}
var _pool_2d: Array[AudioStreamPlayer] = []
var _pool_3d: Array[AudioStreamPlayer3D] = []
var _next_2d := 0
var _next_3d := 0
var _amb: Array[AudioStreamPlayer] = []
var _amb_sound: Array[String] = ["", ""]
var _amb_level: Array[float] = [0.0, 0.0]   # fade position 0..1 (equal-power curve)
var _amb_target: Array[float] = [0.0, 0.0]
var _amb_active := -1
var _amb_state := ""
var _alarm: AudioStreamPlayer
var _alarm_wanted := false
var _sfx_bus := "Master"
var _amb_bus := "Master"
var _lowpass: AudioEffectLowPassFilter
var _cutoff := OPEN_CUTOFF
var _cutoff_target := OPEN_CUTOFF
var _built := false
var _rng := RandomNumberGenerator.new()


func _ready() -> void:
	_build()
	# Re-apply anything requested before we entered the tree.
	if _amb_state != "":
		var state := _amb_state
		_amb_state = ""
		set_ambience(state)
	if _alarm_wanted:
		start_alarm()


func _exit_tree() -> void:
	# Stopping before the players are freed lets the AudioServer release its playbacks.
	_stop_players()


## Silence everything immediately (one-shots, ambience, alarm).
func stop_all() -> void:
	_alarm_wanted = false
	_amb_state = ""
	_amb_target.fill(0.0)
	_amb_level.fill(0.0)
	_amb_sound.fill("")
	_amb_active = -1
	_stop_players()


func _stop_players() -> void:
	for player in _pool_2d:
		player.stop()
	for player in _pool_3d:
		player.stop()
	for player in _amb:
		player.stop()
	if _alarm != null:
		_alarm.stop()


## Play a one-shot. `at` = Vector3 (or a Node3D) for positional audio, else 2D.
## "footstep" picks one of the three footstep variants at random.
func play(sound: String, at = null, volume_db := 0.0) -> void:
	_build()
	if not is_inside_tree():
		return
	var key := sound
	if key == "footstep":
		key = "footstep_%d" % _rng.randi_range(1, 3)
	var stream := get_stream(key)
	if stream == null:
		return
	var pitch := 1.0
	for prefix in PITCH_JITTER:
		if key.begins_with(prefix):
			var spread: float = PITCH_JITTER[prefix]
			pitch = 1.0 + _rng.randf_range(-spread, spread)
			break
	var pos = at
	if pos is Node3D:
		pos = (pos as Node3D).global_position if (pos as Node3D).is_inside_tree() else (pos as Node3D).position
	if pos is Vector3:
		var i3 := _take(_pool_3d, _next_3d)
		_next_3d = (i3 + 1) % _pool_3d.size()
		var p3 := _pool_3d[i3]
		p3.stop()
		p3.stream = stream
		p3.volume_db = volume_db
		p3.pitch_scale = pitch
		p3.global_position = pos
		p3.play()
	else:
		var i2 := _take(_pool_2d, _next_2d)
		_next_2d = (i2 + 1) % _pool_2d.size()
		var p2 := _pool_2d[i2]
		p2.stop()
		p2.stream = stream
		p2.volume_db = volume_db
		p2.pitch_scale = pitch
		p2.play()


## "restored" (station hum), "emergency" (failing power), "blackout" (emergency,
## quieter and muffled) or "off". Crossfades over AMBIENCE_FADE seconds.
func set_ambience(state: String) -> void:
	_build()
	var key := state.strip_edges().to_lower()
	var sound := ""
	var level := 1.0
	var cutoff := OPEN_CUTOFF
	match key:
		"restored", "station", "normal":
			sound = "ambience_station"
		"emergency":
			sound = "ambience_emergency"
		"blackout":
			sound = "ambience_emergency"
			level = _level_for_db(BLACKOUT_DB if _lowpass != null else BLACKOUT_DB_NO_FILTER)
			cutoff = BLACKOUT_CUTOFF
		"", "off", "none", "silent":
			sound = ""
		_:
			push_warning("Sfx.set_ambience: unknown state '%s'" % state)
			return
	_amb_state = key
	_cutoff_target = cutoff
	if not is_inside_tree():
		return  # applied again from _ready()
	if sound == "":
		_amb_target[0] = 0.0
		_amb_target[1] = 0.0
		return
	# Same loop already up (or fading out): just retarget its level.
	for i in 2:
		if _amb_sound[i] == sound and _amb[i].playing:
			_amb_target[i] = level
			_amb_target[1 - i] = 0.0
			_amb_active = i
			return
	var stream := get_loop_stream(sound)
	if stream == null:
		return
	var next := 1 if _amb_active == 0 else 0
	if _amb_active != -1:
		_amb_target[_amb_active] = 0.0
	var player := _amb[next]
	player.stop()
	player.stream = stream
	player.volume_db = -80.0
	_amb_sound[next] = sound
	_amb_level[next] = 0.0
	_amb_target[next] = level
	_amb_active = next
	# Random start point so every round doesn't open on the same creak.
	player.play(_rng.randf() * maxf(stream.get_length() - 0.1, 0.0))


func start_alarm() -> void:
	_build()
	_alarm_wanted = true
	if not is_inside_tree():
		return
	var stream := get_loop_stream("alarm_pod")
	if stream == null:
		return
	_alarm.volume_db = ALARM_DB
	if not _alarm.playing:
		_alarm.stream = stream
		_alarm.play()


func stop_alarm() -> void:
	_alarm_wanted = false  # _process fades it out and stops it


func is_alarm_playing() -> bool:
	return _alarm != null and _alarm.playing


func get_ambience_state() -> String:
	return _amb_state


## Cached one-shot stream for res://assets/audio/<sound>.wav (null if missing).
func get_stream(sound: String) -> AudioStream:
	if _streams.has(sound):
		return _streams[sound]
	var path := AUDIO_DIR + sound + ".wav"
	var stream: AudioStream = null
	if ResourceLoader.exists(path):
		stream = load(path) as AudioStream
	if stream == null:
		push_warning("Sfx: missing sound '%s'" % path)
	_streams[sound] = stream
	return stream


## Looping copy of a stream (the shared one-shot resource is left untouched).
func get_loop_stream(sound: String) -> AudioStream:
	if _loop_streams.has(sound):
		return _loop_streams[sound]
	var base := get_stream(sound)
	var looped: AudioStream = null
	if base is AudioStreamWAV:
		var wav := (base as AudioStreamWAV).duplicate() as AudioStreamWAV
		wav.loop_mode = AudioStreamWAV.LOOP_FORWARD
		wav.loop_begin = 0
		wav.loop_end = frame_count(wav)
		looped = wav
	elif base != null:
		looped = base.duplicate()
		if "loop" in looped:
			looped.set("loop", true)
	_loop_streams[sound] = looped
	return looped


## Number of sample frames in a WAV stream.
@warning_ignore("integer_division")
static func frame_count(wav: AudioStreamWAV) -> int:
	var channels := 2 if wav.stereo else 1
	match wav.format:
		AudioStreamWAV.FORMAT_16_BITS:
			return wav.data.size() / (2 * channels)
		AudioStreamWAV.FORMAT_8_BITS:
			return wav.data.size() / channels
	return int(round(wav.get_length() * wav.mix_rate))


func preload_all() -> int:
	var loaded := 0
	for sound in SOUNDS:
		if get_stream(sound) != null:
			loaded += 1
	return loaded


func _process(delta: float) -> void:
	if not _built:
		return
	var step := delta / AMBIENCE_FADE
	for i in 2:
		var player := _amb[i]
		if _amb_level[i] != _amb_target[i]:
			_amb_level[i] = move_toward(_amb_level[i], _amb_target[i], step)
		var gain := sin(_amb_level[i] * PI * 0.5)
		player.volume_db = linear_to_db(maxf(gain, 0.0001))
		if _amb_level[i] <= 0.0 and _amb_target[i] <= 0.0 and player.playing:
			player.stop()
			_amb_sound[i] = ""
	if not _alarm_wanted and _alarm.playing:
		_alarm.volume_db -= delta * 60.0 / ALARM_FADE
		if _alarm.volume_db <= -60.0:
			_alarm.stop()
	if _lowpass != null and not is_equal_approx(_cutoff, _cutoff_target):
		var k := clampf(delta * 3.0, 0.0, 1.0)
		_cutoff = exp(lerpf(log(_cutoff), log(_cutoff_target), k))
		if absf(_cutoff - _cutoff_target) < 1.0:
			_cutoff = _cutoff_target
		_lowpass.cutoff_hz = _cutoff
		_set_lowpass_enabled(_cutoff < OPEN_CUTOFF * 0.95)


func _build() -> void:
	if _built:
		return
	_built = true
	_rng.randomize()
	_sfx_bus = _ensure_bus(SFX_BUS)
	_amb_bus = _ensure_bus(AMBIENCE_BUS)
	_setup_lowpass()
	for i in POOL_SIZE:
		var p2 := AudioStreamPlayer.new()
		p2.name = "Sfx2D%d" % i
		p2.bus = _sfx_bus
		add_child(p2)
		_pool_2d.append(p2)
		var p3 := AudioStreamPlayer3D.new()
		p3.name = "Sfx3D%d" % i
		p3.bus = _sfx_bus
		p3.unit_size = UNIT_SIZE
		p3.max_distance = MAX_DISTANCE
		p3.attenuation_model = AudioStreamPlayer3D.ATTENUATION_INVERSE_SQUARE_DISTANCE
		p3.doppler_tracking = AudioStreamPlayer3D.DOPPLER_TRACKING_DISABLED
		add_child(p3)
		_pool_3d.append(p3)
	for i in 2:
		var a := AudioStreamPlayer.new()
		a.name = "Ambience%d" % i
		a.bus = _amb_bus
		a.volume_db = -80.0
		add_child(a)
		_amb.append(a)
	_alarm = AudioStreamPlayer.new()
	_alarm.name = "Alarm"
	_alarm.bus = _sfx_bus
	add_child(_alarm)


## Prefer an idle player starting at the round-robin cursor; otherwise steal the cursor's.
func _take(pool: Array, cursor: int) -> int:
	var count := pool.size()
	for offset in count:
		var idx := (cursor + offset) % count
		if not pool[idx].playing:
			return idx
	return cursor % count


func _ensure_bus(bus_name: String) -> String:
	var idx := AudioServer.get_bus_index(bus_name)
	if idx == -1:
		AudioServer.add_bus()
		idx = AudioServer.bus_count - 1
		if idx <= 0:
			return "Master"
		AudioServer.set_bus_name(idx, bus_name)
		AudioServer.set_bus_send(idx, "Master")
		idx = AudioServer.get_bus_index(bus_name)
	return bus_name if idx > 0 else "Master"


func _setup_lowpass() -> void:
	if _amb_bus == "Master":
		return  # never touch Master; blackout falls back to a lower volume
	var bus := AudioServer.get_bus_index(_amb_bus)
	if bus <= 0:
		return
	for i in AudioServer.get_bus_effect_count(bus):
		var effect := AudioServer.get_bus_effect(bus, i)
		if effect is AudioEffectLowPassFilter:
			_lowpass = effect
			break
	if _lowpass == null:
		_lowpass = AudioEffectLowPassFilter.new()
		AudioServer.add_bus_effect(bus, _lowpass)
	_lowpass.cutoff_hz = OPEN_CUTOFF
	_set_lowpass_enabled(false)


func _set_lowpass_enabled(enabled: bool) -> void:
	var bus := AudioServer.get_bus_index(_amb_bus)
	if bus <= 0 or _lowpass == null:
		return
	for i in AudioServer.get_bus_effect_count(bus):
		if AudioServer.get_bus_effect(bus, i) == _lowpass:
			if AudioServer.is_bus_effect_enabled(bus, i) != enabled:
				AudioServer.set_bus_effect_enabled(bus, i, enabled)
			return


## Fade position (0..1) whose equal-power gain equals the given dB.
static func _level_for_db(gain_db: float) -> float:
	return asin(clampf(db_to_linear(gain_db), 0.0, 1.0)) / (PI * 0.5)
