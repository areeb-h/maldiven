{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:maldiven:room-command:v1",
  "title": "Draft client command envelope",
  "description": "Planning schema only. Server derives actor from authenticated connection and enforces semantic/authority rules. This schema does not implement validation or networking.",
  "type": "object",
  "properties": {
    "protocol_major": {
      "const": 1,
      "type": "integer"
    },
    "room_epoch": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "command_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "command_seq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "kind": {
      "enum": [
        "input",
        "interact",
        "fire",
        "extraction",
        "ready",
        "give"
      ]
    },
    "payload": {
      "type": "object"
    }
  },
  "required": [
    "protocol_major",
    "room_epoch",
    "command_id",
    "command_seq",
    "kind",
    "payload"
  ],
  "additionalProperties": false,
  "$defs": {
    "input": {
      "type": "object",
      "properties": {
        "sample_tick": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "move_x": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "move_y": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "yaw": {
          "type": "number",
          "minimum": -6.284,
          "maximum": 6.284
        },
        "pitch": {
          "type": "number",
          "minimum": -1.571,
          "maximum": 1.571
        },
        "sprint": {
          "type": "boolean"
        }
      },
      "required": [
        "sample_tick",
        "move_x",
        "move_y",
        "yaw",
        "pitch",
        "sprint"
      ],
      "additionalProperties": false
    },
    "interact": {
      "type": "object",
      "properties": {
        "entity_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "verb": {
          "enum": [
            "inspect",
            "pickup",
            "drop",
            "use",
            "begin_carry",
            "release_carry",
            "revive"
          ]
        }
      },
      "required": [
        "entity_id",
        "expected_revision",
        "verb"
      ],
      "additionalProperties": false
    },
    "fire": {
      "type": "object",
      "properties": {
        "weapon_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "shot_seq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "aim": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number",
            "minimum": -1,
            "maximum": 1
          }
        }
      },
      "required": [
        "weapon_id",
        "shot_seq",
        "aim"
      ],
      "additionalProperties": false
    },
    "extraction": {
      "type": "object",
      "properties": {
        "route_id": {
          "enum": [
            "main_shuttle",
            "cargo_pod"
          ]
        },
        "action": {
          "enum": [
            "arm",
            "cancel"
          ]
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        }
      },
      "required": [
        "route_id",
        "action",
        "expected_revision"
      ],
      "additionalProperties": false
    },
    "ready": {
      "type": "object",
      "properties": {
        "is_ready": {
          "type": "boolean"
        }
      },
      "required": [
        "is_ready"
      ],
      "additionalProperties": false
    },
    "give": {
      "type": "object",
      "properties": {
        "action": {
          "enum": [
            "offer",
            "accept",
            "decline"
          ]
        },
        "item_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "recipient_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "offer_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        }
      },
      "required": [
        "action",
        "item_id",
        "recipient_id",
        "expected_revision"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "enum": [
                  "accept",
                  "decline"
                ]
              }
            }
          },
          "then": {
            "required": [
              "offer_id"
            ]
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "input"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/input"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "interact"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/interact"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "fire"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/fire"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "extraction"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/extraction"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "ready"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/ready"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "give"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/give"
          }
        }
      }
    }
  ]
}
